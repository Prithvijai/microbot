<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="robotnik_warehouse">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://workcell</uri>
      <name>workcell</name>
      <pose>-0.040107 0.052292 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_0</name>
      <pose>2.88085 5.68612 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_1</name>
      <pose>3.8356 5.68259 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_2</name>
      <pose>4.95299 5.6442 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_3</name>
      <pose>5.85776 5.64162 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_4</name>
      <pose>7.00972 5.66323 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://workcell_bin</uri>
      <name>workcell_bin_5</name>
      <pose>8.07235 5.67521 0 0 0 0</pose>
    </include>
  </world>
</sdf>
